PORT=4000
DATABASE_URL=postgres://foodflow:foodflow@localhost:5432/foodflow
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me
LOG_LEVEL=info

# Run the dispatch loop inside the API process. Set to false when running `npm run worker` separately.
EMBEDDED_WORKER=true

# Dispatch tuning
DISPATCH_RADII_KM=3,6,10
DISPATCH_MAX_ATTEMPTS=8
W_DISTANCE=0.4
W_ETA=0.35
W_WORKLOAD=0.25
